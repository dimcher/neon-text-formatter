{
  "name": "@dimcher/neon-text-formatter",
  "version": "0.2.0",
  "description": "NPM package for text formating extended with Rust module",
  "main": "index.js",
  "author": "Dima Chernyshev <dimcher@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimcher/neon-text-formatter.git"
  },
  "scripts": {
    "build:native": "napi build --platform --release --manifest-path rust/napi/Cargo.toml --output-dir . --js binding.js --dts binding.d.ts",
    "demo": "node demo/server.js",
    "test": "jest",
    "test:rust": "cargo test -p text-formatter-core --manifest-path rust/Cargo.toml",
    "test:all": "npm run build:native && npm run test:rust && cross-env REQUIRE_ADDON=1 jest",
    "prepare": "husky || true",
    "samples": "node scripts/readme-samples.js",
    "samples:write": "node scripts/readme-samples.js --write",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm --gh-release=false"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2"
  },
  "engines": {
    "node": ">=16"
  },
  "napi": {
    "binaryName": "text-formatter",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "files": [
    "index.js",
    "binding.js",
    "binding.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "types": "binding.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
