{
  "name": "@dimcher/neon-text-formatter",
  "version": "0.2.0",
  "description": "NPM package for text formating extended with Rust module",
  "main": "index.js",
  "author": "Dima Chernyshev <dimcher@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimcher/neon-text-formatter.git"
  },
  "scripts": {
    "start": "ts-node index.js",
    "build": "tsc",
    "build:native": "node scripts/build-native.js",
    "test": "jest",
    "test:rust": "cargo test -p text-formatter-core --manifest-path neon/Cargo.toml",
    "test:all": "npm run build:native && npm run test:rust && REQUIRE_ADDON=1 jest"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run test"
    }
  },
  "dependencies": {
    "neon-cli": "^0.1.0"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "husky": "^8.0.1",
    "jest": "^28.1.0"
  }
}